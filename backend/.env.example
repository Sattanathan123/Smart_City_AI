# Spring Boot Production Environment Variables
PORT=8082
SPRING_DATASOURCE_URL=jdbc:mysql://your-mysql-host:3306/smart_city_db?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password
ML_SERVICE_BASE_URL=https://smart-city-ml.onrender.com
JWT_SECRET=YourSuperLongRandom256BitJwtSecretKeyGoesHere!
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_official_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password
